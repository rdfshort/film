SYLN_BASE_URL=https://apishort.com
SYLN_API_TOKEN=PASTE_YOUR_APISHORT_KEY_HERE
SYLN_AUTH_HEADER=X-API-Key
SYLN_AUTH_SCHEME=none
SYLN_DEFAULT_PLATFORM=shortmax
SYLN_PLATFORMS=shortmax,blinkdrama
SYLN_LANG=id
SYLN_REQUESTS_PER_SECOND=2
SYLN_DAILY_BUDGET=90
SYLN_QUALITY=720
SYLN_PATH_PLATFORMS=none
SYLN_PATH_PLAY=none
SYLN_PATH_PING=/v1/{platform}/api/v1/languages
SYLN_PATH_CATALOG=/v1/{platform}/api/v1/popular
SYLN_PATH_SEARCH=/v1/{platform}/api/v1/search
SYLN_PATH_FILM=/v1/{platform}/api/v1/detail/{id}
SYLN_PATH_EPISODES=/v1/{platform}/api/v1/alleps/{id}
SYLN_FIELD_MAP={"film":{"id":["code"],"episodeCount":["episodes"],"genres":["tags"]}}
